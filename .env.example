# ============================================================
#  Copie este arquivo para ".env" e preencha os valores.
#  O arquivo .env NÃO deve ser publicado no GitHub.
# ============================================================

# Access Token do Mercado Pago (suas credenciais > Access Token)
# Começa com "TEST-" (teste) ou "APP_USR-" (produção)
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# Endereço público do site.
# Em produção use sempre HTTPS (o Mercado Pago exige HTTPS no retorno automático).
BASE_URL=http://localhost:3000

# Porta do servidor local
PORT=3000
